local function disconnectAll()
for _, connection in ipairs(connections) do
pcall(function()
connection:Disconnect()
end)
end
table.clear(connections)
end

local function cleanupVisuals()
if ScreenGui then
pcall(function() ScreenGui:Destroy() end)
ScreenGui = nil
end

if CyanEffect then  
    pcall(function() CyanEffect:Destroy() end)  
    CyanEffect = nil  
end

end

local function stop()
if not alive then return end
alive = false

disconnectAll()  
cleanupVisuals()  

for _, sound in ipairs({SpawnSound, CrucifixSound}) do  
    if sound then  
        pcall(function() sound:Stop() end)  
    end  
end  

if Entity then  
    pcall(function() Entity:Despawn() end)  
    Entity = nil  
end  

Model = nil

end

_G.DEPTH_BETA2_STOP = stop

local function createSpawnEffects()
if not alive then return end

-- Cyan screen flash  
if CyanEffect then  
    pcall(function() CyanEffect:Destroy() end)  
end  

CyanEffect = Instance.new("ColorCorrectionEffect")  
CyanEffect.Name = "DepthBeta2Cyan"  
CyanEffect.TintColor = Color3.new(1, 1, 1)  
CyanEffect.Contrast = 0  
CyanEffect.Saturation = 0  
CyanEffect.Brightness = 0  
CyanEffect.Parent = Lighting  

local fadeIn = TweenService:Create(  
    CyanEffect,  
    TweenInfo.new(0.65),  
    {  
        TintColor = Color3.fromRGB(0, 255, 255),  
        Contrast = 0.15,  
        Saturation = -0.1  
    }  
)  
fadeIn:Play()  

task.spawn(function()  
    task.wait(0.35)  
    if not alive or not CyanEffect then return end  

    local effect = CyanEffect  
    local fadeOut = TweenService:Create(  
        effect,  
        TweenInfo.new(1.1),  
        {  
            TintColor = Color3.new(1, 1, 1),  
            Contrast = 0,  
            Saturation = 0,  
            Brightness = 0  
        }  
    )  

    fadeOut:Play()  
    fadeOut.Completed:Wait()  

    if CyanEffect == effect then  
        effect:Destroy()  
        CyanEffect = nil  
    end  
end)  

-- Spawn sound  
SpawnSound = Instance.new("Sound")  
SpawnSound.Name = "DepthSpawnSound"  
SpawnSound.SoundId = SPAWN_SOUND_ID  
