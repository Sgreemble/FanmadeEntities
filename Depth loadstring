local function findRushNew(model)
-- Search ONLY inside Depth's model.
for _, object in ipairs(model:GetDescendants()) do
if object.Name == "RushNew" and object:IsA("BasePart") then
return object
end
end
return nil
end

local function playCrucifixSound(model)
if CrucifixStarted or not alive then return end
CrucifixStarted = true

-- Hide the face and static immediately.  
if Face then Face.ImageTransparency = 1 end  
if Static then Static.ImageTransparency = 1 end  

local rushNew = findRushNew(model)  
if not rushNew then  
    warn("[DEPTH] RushNew was not found inside Depth's model.")  
    return  
end  

-- Reuse the matching sound if it already exists inside RushNew.  
local sound  
for _, object in ipairs(rushNew:GetDescendants()) do  
    if object:IsA("Sound") and object.SoundId == CRUCIFIX_SOUND_ID then  
        sound = object  
        break  
    end  
end  

if not sound then  
    sound = Instance.new("Sound")  
    sound.Name = "DepthCrucifixSound"  
    sound.SoundId = CRUCIFIX_SOUND_ID  
    sound.Parent = rushNew  
end  

sound.Volume = 3  
CrucifixSound = sound  

pcall(function()  
    sound:Play()  
end)

end

local function updateFaceAndStatic()
if not alive or not Model or not Model.Parent then
if Face then Face.ImageTransparency = 1 end
if Static then Static.ImageTransparency = 1 end
return
end

if not Face or not Static then return end  

-- Crucifixion: hide effects immediately.  
if Model:GetAttribute("BeingBanished") then  
    if not CrucifixStarted then  
        playCrucifixSound(Model)  
    end  
    Face.ImageTransparency = 1  
    Static.ImageTransparency = 1  
    return  
elseif CrucifixStarted then  
    -- Do not restart the sound or visual effect after banishment.  
    Face.ImageTransparency = 1  
    Static.ImageTransparency = 1  
    return  
end  

local camera = workspace.CurrentCamera  
if not camera then return end  

local distance = (camera.CFrame.Position - Model:GetPivot().Position).Magnitude  

if distance >= MAX_FACE_DISTANCE then  
    Face.ImageTransparency = 1  
    Static.ImageTransparency = 1  
    return  
end  

local intensity = math.clamp(  
    (MAX_FACE_DISTANCE - distance) /  
    (MAX_FACE_DISTANCE - FULL_FACE_DISTANCE),  
    0,  
    1  
)  

-- Face fades in as Depth approaches.  
Face.ImageTransparency = 1 - intensity  

-- Static stays semi-transparent; maximum opacity is 0.4.  
Static.ImageTransparency = 1 - (intensity * 0.6)  

-- Animate the static using the three provided frames.  
local now = os.clock()  
if intensity > 0 and now - LastStaticChange >= STATIC_INTERVAL then  
    LastStaticChange = now  
    StaticIndex = (StaticIndex % #STATIC_FRAMES) + 1  
    Static.Image = STATIC_FRAMES[StaticIndex]  
end

end

local function loadSpawner()
local ok, result = pcall(function()
return loadstring(game:HttpGet(SPAWNER_URL))()
end)

if not ok or not result then  
    warn("[DEPTH] Entity Spawner V2 failed to load:", result)  
    return nil  
end  

return result

end

