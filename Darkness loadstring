--// DARKNESS ALWAYS LOOKS AT THE PLAYER
MyEntity:SetCallback("OnSpawned", function()
task.spawn(function()
while MyEntity:IsAlive() do
local Character = Player.Character
local Root = Character and (
Character:FindFirstChild("HumanoidRootPart")
or Character.PrimaryPart
)

local Model = MyEntity.Model  

        if Root and Model and Model.Parent then  
            local Position = Model:GetPivot().Position  

            Model:PivotTo(  
                CFrame.lookAt(Position, Root.Position)  
            )  
        end  

        RunService.RenderStepped:Wait()  
    end  
end)

end)

MyEntity:SetCallback("OnStartMoving", function()
print("Darkness has started moving.")
end)

MyEntity:SetCallback("OnEnterRoom", function(room, firstTime)
if firstTime then
print("Darkness entered: "..room.Name)
end
end)

MyEntity:SetCallback("OnDamagePlayer", function(newHealth)
if newHealth <= 0 then
print("Darkness killed the player.")
end
end)

MyEntity:SetCallback("OnDespawning", function()
print("Darkness is despawning.")
end)

--// SPAWN DARKNESS
MyEntity:Run(true)
