local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local Player = Players.LocalPlayer
local PlayerGui = Player:WaitForChild("PlayerGui")

--====== BLACKOUT EFFECT ======--

local BlackoutGui = Instance.new("ScreenGui")
BlackoutGui.Name = "SmilerBlackout"
BlackoutGui.IgnoreGuiInset = true
BlackoutGui.ResetOnSpawn = false
BlackoutGui.DisplayOrder = 999999
BlackoutGui.Parent = PlayerGui

local BlackFrame = Instance.new("Frame")
BlackFrame.Size = UDim2.fromScale(1, 1)
BlackFrame.Position = UDim2.fromScale(0, 0)
BlackFrame.BackgroundColor3 = Color3.new(0, 0, 0)
BlackFrame.BackgroundTransparency = 0.6
BlackFrame.BorderSizePixel = 0
BlackFrame.Parent = BlackoutGui

-- Fade in
TweenService:Create(
    BlackFrame,
    TweenInfo.new(0.25),
    {BackgroundTransparency = 0}
):Play()

task.wait(0.25)

-- Completely black for 2 seconds
task.wait(2)

-- Fade out
local FadeOut = TweenService:Create(
    BlackFrame,
    TweenInfo.new(0.5),
    {BackgroundTransparency = 1}
)

FadeOut:Play()
FadeOut.Completed:Wait()

BlackoutGui:Destroy()

--====== LOAD SPAWNER ======--

local Spawner = loadstring(game:HttpGet(
